# Скопируйте в .env и заполните. Пустые значения = функция выключена.

# Адрес сайта без слэша в конце (нужен для возврата после оплаты)
BASE_URL=https://kartochka.example.ru
PORT=3000
# 1, если сервер стоит за прокси/балансировщиком (Render, Railway, nginx)
TRUST_PROXY=1

# ИИ: ключ с https://console.anthropic.com. Без него работает демо-режим.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
EFFORT=low

# Бесплатных карточек в день на пользователя
FREE_PER_DAY=3

# ЮKassa: https://yookassa.ru/my → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram: токен от @BotFather и имя бота (для ссылки на сайте)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Где хранить данные (лимиты, PRO-коды, заказы)
DATA_FILE=./data/store.json
